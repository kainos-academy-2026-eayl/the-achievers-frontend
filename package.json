{
  "name": "achievers-frontend",
  "version": "1.0.0",
  "description": "Frontend application for Achievers",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run typecheck && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js --sourcemap",
    "typecheck": "tsc",
    "start": "node dist/index.js",
    "lint": "biome lint src",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/nunjucks": "^3.2.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.28.2",
    "supertest": "^7.3.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "nunjucks": "^3.2.4"
  }
}
