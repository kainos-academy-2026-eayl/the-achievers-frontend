{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/auth.css">
{% endblock %}

{% block content %}
  <section class="auth-page" aria-labelledby="registration-title">
  <div class="auth-card">
    <h1 id="registration-title">Register</h1>
    <p class="auth-notice" id="registration-notice" role="{{ 'alert' if registrationError else 'status' }}">{{ registrationMessage | default("Your details will be sent to the registration service.") }}</p>
    {% if registrationErrors %}
      <ul class="auth-errors">
        {% for error in registrationErrors %}<li>{{ error }}</li>{% endfor %}
      </ul>
    {% endif %}

    <form class="auth-form" action="/registration" method="post" aria-describedby="registration-notice">
      <div class="auth-field">
        <label for="registration-name">Name</label>
        <input id="registration-name" name="name" type="text" autocomplete="name" value="{{ name | default('') }}" required>
      </div>

      <div class="auth-field">
        <label for="registration-email">Email</label>
        <input id="registration-email" name="email" type="email" autocomplete="email" value="{{ email | default('') }}" required>
      </div>

      <div class="auth-field">
        <label for="registration-password">Password</label>
        <input id="registration-password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" aria-describedby="password-hint" required>
        <p class="auth-hint" id="password-hint">Must be at least 12 characters. <span class="password-count" id="password-count" aria-live="polite" hidden></span></p>
      </div>

      <div class="auth-field">
        <label for="registration-confirm-password">Confirm password</label>
        <input id="registration-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required>
      </div>

      <div class="auth-field">
        <label for="safe-word-hint">Safe Word Hint</label>
        <select id="safe-word-hint" name="safeWordHint" required>
          <option value="" disabled {{ 'selected' if not safeWordHint }}>Choose a hint</option>
          <option value="mothers-maiden-name" {{ 'selected' if safeWordHint == 'mothers-maiden-name' }}>What is your mother's maiden name?</option>
          <option value="favourite-movie" {{ 'selected' if safeWordHint == 'favourite-movie' }}>What is your favourite movie?</option>
          <option value="first-pet" {{ 'selected' if safeWordHint == 'first-pet' }}>What was your first pet's name?</option>
          <option value="childhood-friend" {{ 'selected' if safeWordHint == 'childhood-friend' }}>What did you call your childhood bestfriend?</option>
          <option value="holiday" {{ 'selected' if safeWordHint == 'holiday' }}>What is your dream holiday location?</option>
        </select>
      </div>

      <div class="auth-field">
        <label for="registration-safe-word">Safe Word</label>
        <input id="registration-safe-word" name="safeWord" type="password" autocomplete="off" required>
      </div>

      <button class="btn btn-green" type="submit">Register</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Login</a></p>
  </div>
  </section>
  <script src="/js/password-counter.js" defer></script>
{% endblock %}
