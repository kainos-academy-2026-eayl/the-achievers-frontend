{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/auth.css">
{% endblock %}

{% block content %}
  <section class="auth-page" aria-labelledby="registration-title">
  <div class="auth-card">
    <h1 id="registration-title">Register</h1>
    <p class="auth-notice" id="registration-notice" role="{{ 'alert' if registrationError else 'status' }}">{{ registrationMessage | default("Your details will be sent to the registration service.") }}</p>

    <form class="auth-form" action="/registration" method="post" aria-describedby="registration-notice">
      <div class="auth-field">
        <label for="registration-name">Name</label>
        <input id="registration-name" name="name" type="text" autocomplete="name" value="{{ name | default('') }}" required>
      </div>

      <div class="auth-field">
        <label for="registration-email">Email</label>
        <input id="registration-email" name="email" type="email" autocomplete="email" value="{{ email | default('') }}" required>
      </div>

      <div class="auth-field">
        <label for="registration-password">Password</label>
        <input id="registration-password" name="password" type="password" autocomplete="new-password" required>
      </div>

      <button class="btn btn-green" type="submit">Register</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Login</a></p>
  </div>
  </section>
{% endblock %}
