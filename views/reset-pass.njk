{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/auth.css">
{% endblock %}

{% block content %}
  <section class="auth-page" aria-labelledby="reset-title">
  <div class="auth-card">
    <h1 id="reset-title">Reset your password</h1>
    <p class="auth-notice" id="reset-notice">Enter the email address associated with your account. Demo only: this form does not send a reset email.</p>

    <form class="auth-form" aria-describedby="reset-notice" onsubmit="event.preventDefault()">
      <div class="auth-field">
        <label for="reset-email">Email</label>
        <input id="reset-email" name="email" type="email" autocomplete="email" required>
      </div>

      <button class="btn btn-green" type="submit">Send reset link</button>
    </form>

    <p class="auth-switch"><a href="/login">Back to login</a></p>
  </div>
  </section>
{% endblock %}
