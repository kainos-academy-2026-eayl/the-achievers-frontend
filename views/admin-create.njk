{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/auth.css">
{% endblock %}

{% block content %}
<section class="auth-page" aria-labelledby="create-product-title">
  <div class="auth-card">
    <h1 id="create-product-title">Create product</h1>
    <p class="auth-notice">All fields are required. Prices are in pounds (GBP).</p>
    {% if formError %}
      <div role="alert">
        <p>{{ formError }}</p>
        {% if fieldErrors %}
          <ul class="auth-errors">
            {% for field, message in fieldErrors %}
              <li><a href="#product-{{ field }}">{{ message }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    {% endif %}
    <form class="auth-form" action="/admin/products" method="post">
      <input type="hidden" name="csrfToken" value="{{ csrfToken }}">
      <div class="auth-field">
        <label for="product-name">Name</label>
        <input id="product-name" name="name" type="text" maxlength="200" value="{{ values.name }}" required{% if fieldErrors.name %} aria-invalid="true" aria-describedby="product-name-error"{% endif %}>
        {% if fieldErrors.name %}<p id="product-name-error">{{ fieldErrors.name }}</p>{% endif %}
      </div>
      <div class="auth-field">
        <label for="product-description">Description</label>
        <textarea id="product-description" name="description" rows="5" maxlength="2000" required{% if fieldErrors.description %} aria-invalid="true" aria-describedby="product-description-error"{% endif %}>{{ values.description }}</textarea>
        {% if fieldErrors.description %}<p id="product-description-error">{{ fieldErrors.description }}</p>{% endif %}
      </div>
      <div class="auth-field">
        <label for="product-category">Category</label>
        <input id="product-category" name="category" type="text" maxlength="100" value="{{ values.category }}" required{% if fieldErrors.category %} aria-invalid="true" aria-describedby="product-category-error"{% endif %}>
        {% if fieldErrors.category %}<p id="product-category-error">{{ fieldErrors.category }}</p>{% endif %}
      </div>
      <div class="auth-field">
        <label for="product-price">Price (GBP)</label>
        <input id="product-price" name="price" type="number" inputmode="decimal" min="0" max="21474836.47" step="0.01" value="{{ values.price }}" required aria-describedby="product-price-hint{% if fieldErrors.price %} product-price-error{% endif %}"{% if fieldErrors.price %} aria-invalid="true"{% endif %}>
        {% if fieldErrors.price %}<p id="product-price-error">{{ fieldErrors.price }}</p>{% endif %}
      </div>
      <button class="btn btn-green" type="submit">Create product</button>
      <a href="/admin">Cancel and return to catalogue</a>
    </form>
  </div>
</section>
{% endblock %}
