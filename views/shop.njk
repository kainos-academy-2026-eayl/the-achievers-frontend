{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/shop.css">
{% endblock %}

{% block content %}
  <section class="shop" aria-labelledby="shop-title">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {% if selectedCategory %}
            <li><a href="/shop">Shop</a></li>
            <li aria-current="page">{{ selectedCategory }}</li>
          {% else %}
            <li aria-current="page">Shop</li>
          {% endif %}
        </ol>
      </nav>

      <header class="shop-header">
        <h1 id="shop-title" class="shop-title">
          {%- if searchQuery %}Results for "{{ searchQuery }}"{% if selectedCategory %} in {{ selectedCategory }}{% endif %}
          {%- elif selectedCategory %}{{ selectedCategory }}
          {%- else %}All Products{% endif -%}
        </h1>
        {% if products.length %}
          <p class="results-count">{{ products.length }} result{% if products.length != 1 %}s{% endif %}</p>
        {% endif %}
      </header>

      <div class="shop-layout">
      {% if not loadError %}
        <aside class="shop-sidebar">
          <nav class="category-filter" aria-labelledby="category-filter-title">
            <h2 id="category-filter-title" class="sidebar-title">Categories</h2>
            {% if categories.length %}
              <ul class="category-list" role="list">
                <li>
                  <a class="category-link" href="/shop{% if searchQuery %}?q={{ searchQuery | urlencode }}{% endif %}"{% if not selectedCategory %} aria-current="page"{% endif %}>All products</a>
                </li>
                {% for category in categories %}
                  <li>
                    <a class="category-link" href="/shop?category={{ category | urlencode }}{% if searchQuery %}&amp;q={{ searchQuery | urlencode }}{% endif %}"{% if category == selectedCategory %} aria-current="page"{% endif %}>{{ category }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <p class="category-empty" role="status">No categories available.</p>
            {% endif %}
          </nav>
        </aside>
      {% endif %}

      <div class="shop-results">
      {% if loadError %}
        <div class="catalogue-message" role="alert">
          <h2>We can't show products right now</h2>
          <p>Something went wrong while loading the catalogue. Please try again later.</p>
        </div>
      {% elif invalidCategory %}
        <div class="catalogue-message" role="alert">
          <h2>Invalid category</h2>
          <p>The selected category could not be applied. <a href="/shop">View all products</a>.</p>
        </div>
      {% elif invalidSearch %}
        <div class="catalogue-message" role="alert">
          <h2>Invalid search</h2>
          <p>Your search could not be applied. <a href="/shop">View all products</a>.</p>
        </div>
      {% elif searchQuery and not products.length %}
        <div class="catalogue-message" role="status">
          <h2>No products found</h2>
          <p>No products match "{{ searchQuery }}"{% if selectedCategory %} in "{{ selectedCategory }}"{% endif %}. Try a different search or <a href="/shop">view all products</a>.</p>
        </div>
      {% elif selectedCategory and not products.length %}
        <div class="catalogue-message" role="status">
          <h2>No products found</h2>
          <p>There are no products in "{{ selectedCategory }}". <a href="/shop">Clear filter</a> to view all products.</p>
        </div>
      {% elif not products.length %}
        <div class="catalogue-message" role="status">
          <h2>No products available</h2>
          <p>There are currently no products in the catalogue. Please check back soon.</p>
        </div>
      {% else %}
        <ul class="catalogue-grid" role="list">
          {% for product in products %}
            <li>
              <article class="product-tile" aria-labelledby="product-{{ product.id }}">
                <div class="product-image" aria-hidden="true">
                  <img src="/css/images/cc-icon.png" alt="" loading="lazy">
                </div>

                <div class="product-body">
                  <p class="product-category">{{ product.category }}</p>
                  <h2 id="product-{{ product.id }}" class="product-name">{{ product.name }}</h2>

                  <div class="product-rating">
                    {% if product.rating is number %}
                      <span class="stars" role="img" aria-label="Rated {{ product.rating }} out of 5">
                        <span class="stars-fill" style="width: {{ product.ratingPercent }}%"></span>
                      </span>
                      <span class="review-count">({{ product.reviewCount }})</span>
                    {% else %}
                      <span class="review-count">No reviews yet</span>
                    {% endif %}
                  </div>

                  <p class="product-description">{{ product.description }}</p>
                  {% if product.inStock is not none %}
                    <p class="stock-status{% if not product.inStock %} out-of-stock{% endif %}" role="status">{% if product.inStock %}In stock{% else %}Out of stock{% endif %}</p>
                  {% endif %}

                  <div class="product-footer">
                    <p class="product-price">{{ product.price }}</p>
                    <form action="/cart/items/add" method="post">
                      <input type="hidden" name="productId" value="{{ product.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="add-to-cart" aria-label="Add {{ product.name }} to cart"{% if product.inStock == false %} disabled{% endif %}>Add to cart</button>
                    </form>
                  </div>
                </div>
              </article>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
      </div>
      </div>
    </div>
  </section>
{% endblock %}
