{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/home-page.css">
  <link rel="stylesheet" href="/css/shop.css">
{% endblock %}

{% block content %}
  <section class="section" aria-labelledby="shop-title">
    <div class="container">
      <div class="results-bar">
        <h1 id="shop-title" class="results-title">{{ selectedCategory if selectedCategory else "All Products" }}</h1>
        {% if products.length %}
          <p class="results-count">{{ products.length }} result{% if products.length != 1 %}s{% endif %}</p>
        {% endif %}
      </div>

      {% if not loadError %}
        <nav class="category-filter" aria-label="Filter by category">
          {% if categories.length %}
            <ul class="category-list" role="list">
              <li>
                <a class="category-chip" href="/shop"{% if not selectedCategory %} aria-current="page"{% endif %}>All</a>
              </li>
              {% for category in categories %}
                <li>
                  <a class="category-chip" href="/shop?category={{ category | urlencode }}"{% if category == selectedCategory %} aria-current="page"{% endif %}>{{ category }}</a>
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <p class="category-empty" role="status">No categories available.</p>
          {% endif %}
        </nav>
      {% endif %}

      {% if loadError %}
        <div class="catalogue-message" role="alert">
          <h2>We can't show products right now</h2>
          <p>Something went wrong while loading the catalogue. Please try again later.</p>
        </div>
      {% elif invalidCategory %}
        <div class="catalogue-message" role="alert">
          <h2>Invalid category</h2>
          <p>The selected category could not be applied. <a href="/shop">View all products</a>.</p>
        </div>
      {% elif selectedCategory and not products.length %}
        <div class="catalogue-message" role="status">
          <h2>No products found</h2>
          <p>There are no products in "{{ selectedCategory }}". <a href="/shop">Clear filter</a> to view all products.</p>
        </div>
      {% elif not products.length %}
        <div class="catalogue-message" role="status">
          <h2>No products available</h2>
          <p>There are currently no products in the catalogue. Please check back soon.</p>
        </div>
      {% else %}
        {% set placeholders = cycler("cue", "case", "ball", "acc") %}
        <ul class="catalogue-grid" role="list">
          {% for product in products %}
            <li>
              <article class="card catalogue-card" aria-labelledby="product-{{ product.id }}">
                <div class="placeholder placeholder-{{ placeholders.next() }}" aria-hidden="true"></div>
                <p class="product-category">{{ product.category }}</p>
                <h2 id="product-{{ product.id }}" class="product-name">{{ product.name }}</h2>

                <div class="product-rating">
                  {% if product.rating is number %}
                    <span class="stars" role="img" aria-label="Rated {{ product.rating }} out of 5">
                      <span class="stars-fill" style="width: {{ product.ratingPercent }}%"></span>
                    </span>
                    <span class="review-count">({{ product.reviewCount }})</span>
                  {% else %}
                    <span class="review-count">No reviews yet</span>
                  {% endif %}
                </div>

                <p class="product-description">{{ product.description }}</p>
                <p class="price">{{ product.price }}</p>
                <form action="/cart/items/add" method="post">
                  <input type="hidden" name="productId" value="{{ product.id }}">
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="btn btn-gold" aria-label="Add {{ product.name }} to cart">Add to Cart</button>
                </form>
              </article>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </section>
{% endblock %}
