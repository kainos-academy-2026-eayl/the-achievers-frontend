{% extends "layout.njk" %}

{% block styles %}
  <link rel="stylesheet" href="/css/auth.css">
  <link rel="stylesheet" href="/css/profile.css">
{% endblock %}

{% macro field(id, label, type="text", autocomplete="off", required=false, maxlength=100, hint="", conditional=false) %}
  {% set error = fieldErrors[id] if fieldErrors else "" %}
  <div class="auth-field{{ ' has-error' if error }}">
    <label for="profile-{{ id }}">{{ label }}{% if not required and not conditional %} <span class="optional">(optional)</span>{% endif %}</label>
    {% if hint %}<p class="auth-hint" id="profile-{{ id }}-hint">{{ hint }}</p>{% endif %}
    {% if error %}<p class="field-error" id="profile-{{ id }}-error">{{ error }}</p>{% endif %}
    <input id="profile-{{ id }}" name="{{ id }}" type="{{ type }}" autocomplete="{{ autocomplete }}" maxlength="{{ maxlength }}"
      {% if type != "password" %}value="{{ values[id] | default('') }}"{% endif %}
      {% if required %}required{% endif %}
      {% if error %}aria-invalid="true"{% endif %}
      {% if error or hint %}aria-describedby="{{ 'profile-' + id + '-hint' if hint }} {{ 'profile-' + id + '-error' if error }}"{% endif %}>
  </div>
{% endmacro %}

{% macro addressFields(slot, section, withLabel=false) %}
  <p class="auth-hint">If you add this address, address line 1, town or city and postcode are required.</p>
  {% if withLabel %}
    {{ field(slot + "-label", "Address name", maxlength=40, hint="For example Work or Mum's house") }}
  {% endif %}
  {{ field(slot + "-addressLine1", "Address line 1", autocomplete=section + " address-line1", conditional=true) }}
  {{ field(slot + "-addressLine2", "Address line 2", autocomplete=section + " address-line2") }}
  {{ field(slot + "-city", "Town or city", autocomplete=section + " address-level2", maxlength=60, conditional=true) }}
  {{ field(slot + "-postcode", "Postcode", autocomplete=section + " postal-code", maxlength=10, conditional=true) }}
{% endmacro %}

{% block content %}
  <section class="auth-page" aria-labelledby="profile-title">
  <div class="auth-card profile-card">
    <h1 id="profile-title">My Profile</h1>

    {% if notLoggedIn %}
      <p class="auth-notice" role="alert">Please log in to view your profile.</p>
      <a class="btn btn-green" href="/login">Log in</a>
    {% elif loadError %}
      <p class="auth-notice" role="alert">We can't load your profile right now. Please try again later.</p>
      <a class="btn btn-gold" href="/profile">Try again</a>
    {% else %}
      {% if updated %}
        <p class="profile-success" role="status">Your profile has been updated.</p>
      {% endif %}
      {% if formError %}
        <p class="profile-error" role="alert">{{ formError }}</p>
      {% endif %}

      <form class="auth-form" action="/profile" method="post" novalidate>
        <fieldset>
          <legend>Personal details</legend>
          {{ field("name", "Name", autocomplete="name", required=true) }}
          {{ field("email", "Email", type="email", autocomplete="email", required=true, maxlength=254) }}
          {{ field("phone", "Phone number", type="tel", autocomplete="tel", maxlength=20, hint="UK number, for example 07123 456789") }}
        </fieldset>

        <fieldset>
          <legend>Home address</legend>
          <p class="auth-hint">You can save up to 3 addresses. Add your home address first.</p>
          {{ addressFields("home", "section-home") }}
        </fieldset>

        {% if fieldErrors and fieldErrors.otherAddresses %}
          <p class="field-error" role="alert">{{ fieldErrors.otherAddresses }}</p>
        {% endif %}

        <fieldset>
          <legend>Other address 1</legend>
          {{ addressFields("other0", "section-other0", withLabel=true) }}
        </fieldset>

        <fieldset>
          <legend>Other address 2</legend>
          {{ addressFields("other1", "section-other1", withLabel=true) }}
        </fieldset>

        <fieldset>
          <legend>Confirm changes</legend>
          {{ field("currentPassword", "Current password", type="password", autocomplete="current-password", required=true, maxlength=128, hint="Enter your current password to save any changes.") }}
        </fieldset>

        <button class="btn btn-green" type="submit">Save changes</button>
      </form>
    {% endif %}
  </div>
  </section>
{% endblock %}
