<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <!-- Shared styles for every page -->
    <link rel="stylesheet" href="/css/main.css">
    <!-- Page-specific styles -->
    {% block styles %}{% endblock %}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- HEADER: sticky, two levels (top header + navigation bar) -->
    <header class="site-header">

      <!-- Level 1: logo (left), search (centre), cart and login (right) -->
      <div class="header-top">
        <div class="container header-top-inner">

          <!-- Logo -->
          <a class="logo" href="/">
            <img class="logo-img" src="/css/images/logo.png" alt="Cue Corner home">
          </a>

          <!-- Search bar -->
          <form class="search" role="search" action="/shop" method="get">
            <label class="visually-hidden" for="site-search">Search products</label>
            <input id="site-search" name="q" type="search" value="{{ searchQuery | default('') }}" maxlength="100" autocomplete="off" list="search-suggestions" placeholder="Search for cues, cases, balls and more">
            <button type="submit" class="search-btn" aria-label="Search">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m21 21-4.3-4.3"></path>
              </svg>
            </button>
            <datalist id="search-suggestions">
              {% for name in productNames %}<option value="{{ name }}"></option>{% endfor %}
            </datalist>
          </form>

          <!-- Cart (icon with count badge) and Login -->
          <div class="header-actions">
            {% if currentUser %}
              <span>Signed in as {{ currentUser.name }}</span>
              <a class="header-btn header-icon" href="/profile" aria-label="My profile" title="My profile">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 21a8 8 0 0 1 16 0"></path>
                </svg>
              </a>
              <form action="/logout" method="post">
                <button class="header-btn header-icon" type="submit" aria-label="Logout" title="Logout">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                  </svg>
                </button>
              </form>
            {% else %}
              <a class="header-btn header-icon" href="/login" aria-label="Login" title="Login">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4"></circle>
                  <path d="M4 21a8 8 0 0 1 16 0"></path>
                </svg>
              </a>
            {% endif %}
            <a class="header-btn header-icon" href="/cart" title="Cart" aria-label="{% if cartCount == '?' %}Cart, item count unavailable{% else %}Cart, {{ cartCount | default(0) }} items{% endif %}">
              <span class="cart-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="9" cy="21" r="1"></circle>
                  <circle cx="20" cy="21" r="1"></circle>
                  <path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"></path>
                </svg>
                <span class="cart-count" aria-hidden="true">{{ cartCount | default(0) }}</span>
              </span>
            </a>
          </div>
        </div>
      </div>

      <!-- Level 2: navigation bar -->
      <nav class="main-nav" aria-label="Main">
        <ul class="container">
          <li><a href="/">Home</a></li>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/categories">Categories</a></li>
          {% if isAdmin %}<li><a href="/admin">Admin dashboard</a></li>{% endif %}
        </ul>
      </nav>
    </header>

    <!-- MAIN: page content goes here -->
    <main id="main">
      {% block content %}{% endblock %}
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-brand">Cue Corner</p>
        <nav aria-label="Footer">
          <ul>
            <li><a href="/about">About Us</a></li>
            <li><a href="/contact">Contact Us</a></li>
            <li><a href="/terms">Terms &amp; Conditions</a></li>
          </ul>
        </nav>
        <p class="copyright">&copy; 2026 Cue Corner. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
